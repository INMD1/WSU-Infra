# WSU Server — Caddy 2 예제 설정  (/etc/caddy/Caddyfile)
#
# 핵심은 @vnc 블록입니다. 브라우저는 WebSocket 에 Authorization 헤더를 실을 수 없기 때문에
# Caddy 가 Proxmox vncwebsocket 으로 프록시하면서 API 토큰을 주입합니다.
# vncwebsocket 은 api.php 가 발급한 일회성 vncticket(해당 VM 경로에 묶임, 수 초 후 만료)이
# 없으면 거부되므로, 이 경로로는 VM 콘솔 연결 외의 API 를 호출할 수 없습니다.
#
# 도메인이 있으면 첫 줄을 도메인으로 바꾸세요 (예: vm.example.com).
# Caddy 가 Let's Encrypt 인증서를 자동으로 발급하고 HTTPS 로 서비스합니다.
# 도메인 없이 내부 IP 로만 쓸 거라면 아래처럼 :80 그대로 두면 됩니다.

:80 {
	root * /var/www/wsu-server/public

	# ─── noVNC WebSocket → Proxmox ─────────────────────────────────
	# 관리자 설정 > 콘솔의 WebSocket 경로(기본 /pve-ws)와 같아야 합니다. 그 화면에 값이 채워진 블록이 있습니다.
	@vnc path_regexp vnc ^/pve-ws/nodes/([A-Za-z0-9._-]+)/qemu/([0-9]+)/vncwebsocket$
	handle @vnc {
		rewrite * /api2/json/nodes/{re.vnc.1}/qemu/{re.vnc.2}/vncwebsocket?{query}

		# Proxmox 노드 주소 (클러스터면 아무 노드나 가능)
		reverse_proxy https://10.0.0.10:8006 {
			header_up Host {upstream_hostport}
			header_up -Cookie
			# 관리자 설정 > Proxmox 연결의 토큰 ID / secret 과 같은 값
			header_up Authorization "PVEAPIToken=vmrental@pve!web=00000000-0000-0000-0000-000000000000"

			transport http {
				tls_insecure_skip_verify # Proxmox 자체 서명 인증서
			}
		}
	}

	# 위 패턴에 맞지 않는 /pve-ws 요청은 차단
	handle /pve-ws/* {
		respond 404
	}

	# 숨김 파일(.htaccess 등) 차단
	@hidden path */.*
	handle @hidden {
		respond 404
	}

	# ─── PHP 앱 ────────────────────────────────────────────────────
	handle {
		encode gzip
		# PHP 버전에 맞게 소켓 경로 수정 (ls /run/php/ 로 확인)
		php_fastcgi unix//run/php/php8.3-fpm.sock
		file_server
	}
}
